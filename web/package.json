{
  "name": "petroknowledge-web",
  "private": true,
  "version": "0.1.0",
  "description": "PetroKnowledge's chat thread: a conversation over the v1 API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "types": "openapi-typescript openapi.json -o app/lib/api-types.ts && prettier --write app/lib/api-types.ts",
    "lint": "eslint . && prettier --check .",
    "design": "impeccable detect app",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "globals": "17.12.0",
    "impeccable": "4.1.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
